# ==============================================================================
# QR DINÂMICO - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL PÚBLICA DA APLICAÇÃO (USADA PARA GERAR OS QR CODES)
# ------------------------------------------------------------------------------
# ATENÇÃO: Esta é a URL ONDE SUA APLICAÇÃO ESTÁ HOSPEDADA (ex: Vercel, domínio próprio).
# É este endereço que será gravado nos QR Codes físicos: https://SEU-DOMINIO/r/001
#
# REGRA CRÍTICA:
# - NUNCA use a URL do Supabase aqui! (A URL do Supabase é apenas banco de dados interno).
# - NUNCA inclua o nome da variável no valor (não faça NEXT_PUBLIC_APP_URL=https://...).
#
# Exemplos corretos:
# Em desenvolvimento local:
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Em produção na Vercel:
# NEXT_PUBLIC_APP_URL="https://meu-dominio.com"
# ou
# NEXT_PUBLIC_APP_URL="https://qr-dinamico.vercel.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. CONEXÃO PRIVADA COM BANCO DE DADOS (POSTGRESQL / SUPABASE)
# ------------------------------------------------------------------------------
# ATENÇÃO: Usada EXCLUSIVAMENTE pelo backend para ler e gravar os dados com segurança.
# Esta URL NUNCA é colocada nos QR Codes nem exposta aos usuários.
#
# Obtenha no painel do Supabase:
# Project Settings > Database > Connection String (modo URI, porta 5432 ou 6543)
# Exemplo:
DATABASE_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. PORTA DO SERVIDOR (OPCIONAL)
# ------------------------------------------------------------------------------
PORT=3000
