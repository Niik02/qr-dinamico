# ==========================================
# VARIÁVEIS DE AMBIENTE - QR DINÂMICO
# ==========================================

# 1. URL pública da aplicação (obrigatória para os links dinâmicos e downloads)
# Exemplo local: http://localhost:3000
# Exemplo Vercel/Produção: https://qr.seudominio.com ou https://seu-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# 2. Conexão com o Banco de Dados Relacional (PostgreSQL / Supabase / Neon / Vercel Postgres)
# Opcional no ambiente local (se vazio, o sistema usa armazenamento JSON persistente local em data/qrcodes.json).
# Em produção na Vercel, conecte seu Supabase ou Postgres aqui:
DATABASE_URL="postgresql://postgres:sua_senha@db.seu-projeto.supabase.co:5432/postgres"

# 3. Porta do Servidor
PORT=3000

# 4. Chave Gemini (injetada automaticamente pelo AI Studio se necessário)
GEMINI_API_KEY=""
