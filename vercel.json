{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/api/redirect?code=:code"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|r).*)",
      "destination": "/index.html"
    }
  ]
}
